#!/bin/sh

case "$1" in
  start)
    mkdir -p /data
    attempts=0
    while ! grep -q ' /data ' /proc/mounts && [ "$attempts" -lt 10 ]; do
      mount /data 2>/tmp/microfx-data-mount.log || true
      grep -q ' /data ' /proc/mounts && break
      attempts=$((attempts + 1))
      sleep 1
    done
    if ! grep -q ' /data ' /proc/mounts; then
      echo "Persistent data partition is not mounted"
      exit 1
    fi

    mkdir -p /data/apps/incoming /data/apps/projects /data/config /data/ssh /data/state
    # Runtime activation owns one fixed /data/apps/runtime directory. Never
    # create a persistent factory copy or an alternate runtime symlink here.
    rm -rf /data/apps/releases /data/apps/runtime.new /data/apps/runtime.retired
    rm -f /data/apps/previous-runtime /data/apps/previous-runtime.new
    for bundled in /usr/share/microfx/projects/*; do
      [ -d "$bundled" ] || continue
      name=${bundled##*/}
      project=/data/apps/projects/$name
      mkdir -p "$project/assets"
      [ -s "$project/main.js" ] || cp "$bundled/main.js" "$project/main.js"
      [ -s "$project/project.json" ] || cp "$bundled/project.json" "$project/project.json"
      if [ -d "$bundled/assets" ]; then
        # Bundled assets may be organized in nested model, font, image, and
        # shader folders. Seed missing files without overwriting user edits.
        (cd "$bundled/assets" && find . -type f -print) | while IFS= read -r relative; do
          asset=$bundled/assets/$relative
          destination=$project/assets/$relative
          [ -f "$destination" ] && continue
          mkdir -p "${destination%/*}"
          cp "$asset" "$destination"
        done
      fi
    done
    demo=/data/apps/projects/demo
    current=
    [ ! -L /data/apps/current ] || current=$(readlink /data/apps/current)
    case "$current" in
      /data/apps/projects/*) ;;
      *)
        rm -f /data/apps/current
        ln -s "$demo" /data/apps/current
        ;;
    esac
    ;;
esac
