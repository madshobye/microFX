#!/bin/sh

run_root=${MICROFX_RUN_ROOT:-/run}
pidfile=$run_root/canvas-supervisor.pid
supervisor=${MICROFX_SUPERVISOR:-/usr/sbin/canvas-supervisor}

case "$1" in
  start)
    if [ -r "$pidfile" ] && kill -0 "$(cat "$pidfile")" 2>/dev/null; then
      echo "Graphics supervisor already running"
      exit 0
    fi
    rm -f "$pidfile"
    echo "Starting graphics supervisor"
    "$supervisor" &
    echo $! >"$pidfile"
    if ! kill -0 "$(cat "$pidfile")" 2>/dev/null; then
      echo "Graphics supervisor failed to start" >&2
      rm -f "$pidfile"
      exit 1
    fi
    ;;
  stop)
    if [ -r "$pidfile" ]; then
      kill "$(cat "$pidfile")" 2>/dev/null || true
      rm -f "$pidfile"
    fi
    killall canvas-demo 2>/dev/null || true
    ;;
  restart)
    "$0" stop
    "$0" start
    ;;
esac
