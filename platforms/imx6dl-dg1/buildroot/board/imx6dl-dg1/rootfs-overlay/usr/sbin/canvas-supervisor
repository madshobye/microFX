#!/bin/sh

config=${CANVAS_CONFIG:-/etc/canvas.conf}
[ -r "$config" ] && . "$config"
runtime_config=${MICROFX_RUNTIME_CONFIG:-/etc/microfx.conf}
[ -r "$runtime_config" ] && . "$runtime_config"
product_config=${MICROFX_PRODUCT_CONFIG:-/etc/microfx-product.conf}
[ -r "$product_config" ] && . "$product_config"
CANVAS_PERSIST_LOGS=${CANVAS_PERSIST_LOGS:-0}
CANVAS_FAIL_FAST=${CANVAS_FAIL_FAST:-1}
MICROFX_DEFAULT_PEER_ID=${MICROFX_DEFAULT_PEER_ID:-graphics-demo}
MICROFX_SETUP_SSID=${MICROFX_SETUP_SSID:-graphics-setup}
MICROFX_SETUP_PASSWORD=${MICROFX_SETUP_PASSWORD:-graphicssetup}
identity_library=${MICROFX_IDENTITY_LIBRARY:-/usr/lib/microfx/device-identity.sh}
[ ! -r "$identity_library" ] || {
    . "$identity_library"
    microfx_load_device_identity
}
MICROFX_DATA_ROOT=${MICROFX_DATA_ROOT:-/data}
MICROFX_RUN_ROOT=${MICROFX_RUN_ROOT:-/run}
MICROFX_FACTORY_APP=${MICROFX_FACTORY_APP:-/usr/bin/canvas-demo}
MICROFX_ONBOARDING_SCRIPT=${MICROFX_ONBOARDING_SCRIPT:-/usr/share/microfx/onboarding.js}
MICROFX_ERROR_SCRIPT=${MICROFX_ERROR_SCRIPT:-/usr/share/microfx/error.js}
MICROFX_HEALTH_SECONDS=${MICROFX_HEALTH_SECONDS:-2}
MICROFX_REQUIRE_DATA_MOUNT=${MICROFX_REQUIRE_DATA_MOUNT:-1}
reload_request=$MICROFX_RUN_ROOT/microfx-project-reload
reload_status=$MICROFX_RUN_ROOT/microfx-project-status
onboarding_marker=$MICROFX_RUN_ROOT/microfx-onboarding-shown
benchmark_overrides=$MICROFX_RUN_ROOT/microfx-benchmark.env
state_root=$MICROFX_DATA_ROOT/state
apps_root=$MICROFX_DATA_ROOT/apps

apply_benchmark_overrides() {
    [ -r "$benchmark_overrides" ] || return 0
    while IFS= read -r line || [ -n "$line" ]; do
        case "$line" in ''|'#'*) continue ;; esac
        key=${line%%=*}
        value=${line#*=}
        case "$key" in
          MICROFX_OUTPUT_WIDTH|MICROFX_OUTPUT_HEIGHT|MICROFX_PIXEL_DENSITY|\
          MICROFX_MIN_PIXEL_DENSITY|MICROFX_TARGET_FPS|MICROFX_COLOR_FORMAT|\
          MICROFX_DEPTH_BITS|MICROFX_DITHERING|MICROFX_ANTIALIASING|\
          MICROFX_PROFILE_INTERVAL) ;;
          *) echo "Ignored unknown volatile benchmark setting: $key"; continue ;;
        esac
        case "$value" in
          ''|*[!A-Za-z0-9._-]*)
            echo "Ignored invalid volatile benchmark value for $key"
            continue
            ;;
        esac
        export "$key=$value"
    done <"$benchmark_overrides"
}

data_available() {
    if [ "$MICROFX_REQUIRE_DATA_MOUNT" = "0" ]; then
        [ -d "$MICROFX_DATA_ROOT" ]
    else
        grep -q " $MICROFX_DATA_ROOT " /proc/mounts
    fi
}

write_activation_status() {
    token=$1 project=$2 state=$3 detail=$4
    mkdir -p "$MICROFX_RUN_ROOT"
    printf '%s\t%s\t%s\t%s\n' "$token" "$project" "$state" "$detail" >"$reload_status.new"
    mv -f "$reload_status.new" "$reload_status"
}

renderer_failure_detail() {
    first_line=$((renderer_log_start + 1))
    detail=$(sed -n "${first_line},\$p" "$log" 2>/dev/null | grep 'MICROFX_JS_ERROR ' | tail -n 1 | sed 's/^.*MICROFX_JS_ERROR //' | tr '\t\r\n' '   ' | sed 's/[[:space:]]*$//')
    [ -n "$detail" ] || detail=$(sed -n "${first_line},\$p" "$log" 2>/dev/null | tail -n 1 | tr '\t\r\n' '   ' | sed 's/[[:space:]]*$//')
    [ -n "$detail" ] || detail="renderer exited during health check"
    printf '%s' "$detail"
}

wait_for_activation_request() {
    error_detail=${1:-}
    echo "Renderer stopped; waiting for the next project activation" >>"$log"
    if [ -n "$error_detail" ] && [ -r "$MICROFX_ERROR_SCRIPT" ]; then
        echo "Starting project error application" >>"$log"
        MICROFX_SCRIPT="$MICROFX_ERROR_SCRIPT" \
        MICROFX_ERROR_DETAIL="$error_detail" \
          "$MICROFX_FACTORY_APP" >>"$log" 2>&1 &
        child=$!
    fi
    while :; do
        if [ -f "$reload_request" ]; then
            IFS="$(printf '\t')" read -r activation_token activation_project <"$reload_request" || true
            rm -f "$reload_request"
            if [ -n "$activation_token" ] && [ -n "$activation_project" ]; then
                if [ -n "$child" ]; then
                    kill "$child" 2>/dev/null || true
                    wait "$child" 2>/dev/null || true
                    child=
                fi
                write_activation_status "$activation_token" "$activation_project" pending "starting renderer after previous failure"
                return 0
            fi
            echo "Ignored malformed project reload request while renderer was stopped" >>"$log"
            activation_token=
            activation_project=
        fi
        sleep 1
    done
}

if [ "$CANVAS_PERSIST_LOGS" = "1" ] && data_available; then
    log=$state_root/canvas.log
else
    log=/tmp/canvas.log
fi

child=
trap 'test -n "$child" && kill "$child" 2>/dev/null; exit 0' TERM INT

rollback() {
    if [ -L "$apps_root/previous-runtime" ]; then
        previous=$(readlink "$apps_root/previous-runtime")
        ln -s "$previous" "$apps_root/current-runtime.new"
        mv -Tf "$apps_root/current-runtime.new" "$apps_root/current-runtime"
        echo "Rolled back canvas application to $previous" >>"$log"
    fi
    rm -f "$state_root/app-pending"
}

onboarding_app=$MICROFX_FACTORY_APP
data_available &&
  [ -x "$apps_root/current-runtime/canvas-demo" ] &&
  onboarding_app=$apps_root/current-runtime/canvas-demo

if [ ! -e "$onboarding_marker" ] &&
   [ -x "$onboarding_app" ] &&
   [ -r "$MICROFX_ONBOARDING_SCRIPT" ]; then
    touch "$onboarding_marker"
    peer_id=$MICROFX_DEFAULT_PEER_ID
    [ ! -s "$MICROFX_DATA_ROOT/config/peer-id" ] || peer_id=$(head -n 1 "$MICROFX_DATA_ROOT/config/peer-id")
    echo "Starting 40-second onboarding application" >>"$log"
    MICROFX_SCRIPT="$MICROFX_ONBOARDING_SCRIPT" \
    MICROFX_PEER_ID="$peer_id" \
    MICROFX_AP_SSID="$MICROFX_SETUP_SSID" \
    MICROFX_AP_PASSWORD="$MICROFX_SETUP_PASSWORD" \
    MICROFX_CAPTIVE_PORTAL=1 \
    MICROFX_PROVISIONING="${MICROFX_PROVISIONING:-0}" \
      "$onboarding_app" >>"$log" 2>&1 &
    child=$!
    wait "$child" || echo "Onboarding application exited with an error" >>"$log"
    child=
fi

activation_token=
activation_project=
renderer_log_start=0

while :; do
    app=$MICROFX_FACTORY_APP
    data_available &&
      [ -x "$apps_root/current-runtime/canvas-demo" ] &&
      app=$apps_root/current-runtime/canvas-demo
    renderer_log_start=$(wc -l "$log" 2>/dev/null | awk '{print $1}')
    case "$renderer_log_start" in ''|*[!0-9]*) renderer_log_start=0;; esac
    echo "Starting $app" >>"$log"
    (
      apply_benchmark_overrides
      if [ -e "$MICROFX_RUN_ROOT/microfx-profile" ]; then
          export MICROFX_PROFILE=1
          export MICROFX_PROFILE_INTERVAL=${MICROFX_PROFILE_INTERVAL:-120}
      fi
      exec "$app"
    ) >>"$log" 2>&1 &
    child=$!
    requested_reload=0

    if [ -n "$activation_token" ]; then
        sleep "$MICROFX_HEALTH_SECONDS"
        if kill -0 "$child" 2>/dev/null; then
            write_activation_status "$activation_token" "$activation_project" running "renderer passed health check"
            echo "Project $activation_project is running (activation $activation_token)" >>"$log"
            activation_token=
            activation_project=
        else
            wait "$child" 2>/dev/null || true
            child=
            failure_detail=$(renderer_failure_detail)
            write_activation_status "$activation_token" "$activation_project" failed "$failure_detail"
            echo "Project $activation_project failed (activation $activation_token)" >>"$log"
            activation_token=
            activation_project=
            if [ "$CANVAS_FAIL_FAST" = "1" ]; then
                wait_for_activation_request "$failure_detail"
            fi
            sleep 1
            continue
        fi
    fi

    if [ -f "$state_root/app-pending" ]; then
        sleep 10
        if kill -0 "$child" 2>/dev/null; then
            rm -f "$state_root/app-pending"
            echo "Canvas application passed its health window" >>"$log"
        else
            wait "$child" 2>/dev/null || true
            child=
            rm -f "$state_root/app-pending"
            echo "Canvas pending release failed its health window" >>"$log"
            if [ "$CANVAS_FAIL_FAST" = "1" ]; then
                echo "Fail-fast enabled; canvas supervisor is stopping" >>"$log"
                exit 1
            fi
            rollback
            sleep 1
            continue
        fi
    fi

    while kill -0 "$child" 2>/dev/null; do
        if [ -f "$reload_request" ]; then
            IFS="$(printf '\t')" read -r activation_token activation_project <"$reload_request" || true
            rm -f "$reload_request"
            if [ -z "$activation_token" ] || [ -z "$activation_project" ]; then
                echo "Ignored malformed project reload request" >>"$log"
                activation_token=
                activation_project=
                continue
            fi
            write_activation_status "$activation_token" "$activation_project" stopping "stopping previous renderer"
            requested_reload=1
            echo "Reloading project $activation_project (activation $activation_token)" >>"$log"
            kill "$child" 2>/dev/null || true
            break
        fi
        sleep 1
    done
    wait "$child" 2>/dev/null || true
    child=
    if [ "$requested_reload" = "1" ]; then
        sleep 1
        continue
    fi
    if [ "$CANVAS_FAIL_FAST" = "1" ]; then
        echo "Canvas application exited; fail-fast supervisor will wait for an explicit activation" >>"$log"
        wait_for_activation_request "$(renderer_failure_detail)"
        continue
    fi
    echo "Canvas application exited; restarting" >>"$log"
    sleep 1
done
