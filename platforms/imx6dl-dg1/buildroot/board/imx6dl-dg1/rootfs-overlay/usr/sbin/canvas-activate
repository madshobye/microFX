#!/bin/sh
set -eu

release=${1:-}
case "$release" in
  ''|*[!A-Za-z0-9._-]*)
    echo "Usage: canvas-activate RELEASE" >&2
    exit 2
    ;;
esac

incoming=/data/apps/incoming/$release
runtime=/data/apps/runtime
staged=/data/apps/runtime.new
retired=/data/apps/runtime.retired

grep -q ' /data ' /proc/mounts || { echo "/data is not mounted" >&2; exit 1; }
[ -d "$incoming" ] || { echo "Missing incoming release: $release" >&2; exit 1; }
[ -x "$incoming/canvas-demo" ] || { echo "Release has no executable canvas-demo" >&2; exit 1; }
[ -f "$incoming/manifest.sha256" ] || { echo "Release has no manifest" >&2; exit 1; }

(cd "$incoming" && sha256sum -c manifest.sha256)

rm -rf "$staged" "$retired"
mv "$incoming" "$staged"

# Stop only after the replacement is complete and verified. The fixed runtime
# directory is then replaced in one short transition; no dated or previous
# runtime is retained on the data partition.
/etc/init.d/S40canvas stop
[ ! -e "$runtime" ] || mv "$runtime" "$retired"
mv "$staged" "$runtime"
rm -f /data/apps/current-runtime /data/apps/current-runtime.new
ln -s "$runtime" /data/apps/current-runtime.new
mv -Tf /data/apps/current-runtime.new /data/apps/current-runtime
rm -f /data/apps/previous-runtime /data/apps/previous-runtime.new
rm -rf "$retired" /data/apps/releases /data/apps/incoming/*
touch /data/state/app-pending
sync
/etc/init.d/S40canvas start
echo "Activated canvas runtime $release"
