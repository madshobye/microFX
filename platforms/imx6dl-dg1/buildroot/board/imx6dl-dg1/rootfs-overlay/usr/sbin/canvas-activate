#!/bin/sh
set -eu

release=${1:-}
case "$release" in
  ''|*[!A-Za-z0-9._-]*)
    echo "Usage: canvas-activate RELEASE" >&2
    exit 2
    ;;
esac

incoming=/data/apps/incoming/$release
destination=/data/apps/releases/$release

grep -q ' /data ' /proc/mounts || { echo "/data is not mounted" >&2; exit 1; }
[ -d "$incoming" ] || { echo "Missing incoming release: $release" >&2; exit 1; }
[ -x "$incoming/canvas-demo" ] || { echo "Release has no executable canvas-demo" >&2; exit 1; }
[ -f "$incoming/manifest.sha256" ] || { echo "Release has no manifest" >&2; exit 1; }

(cd "$incoming" && sha256sum -c manifest.sha256)
[ ! -e "$destination" ] || { echo "Release already exists: $release" >&2; exit 1; }

if [ -L /data/apps/current ]; then
    current=$(readlink /data/apps/current)
    ln -s "$current" /data/apps/previous.new
    mv -Tf /data/apps/previous.new /data/apps/previous
fi

mv "$incoming" "$destination"
ln -s "$destination" /data/apps/current.new
mv -Tf /data/apps/current.new /data/apps/current
touch /data/state/app-pending
sync
/etc/init.d/S40canvas restart
echo "Activated canvas release $release"
