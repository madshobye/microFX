--- a/src/platforms/rcore_drm.c
+++ b/src/platforms/rcore_drm.c
@@ -552,14 +552,25 @@ static void PageFlipHandler(int fd, unsigned int frame, unsigned int sec,
     *waiting = 0;
 }
 
+static double SwapClockMs(void)
+{
+    struct timespec ts = { 0 };
+    clock_gettime(CLOCK_MONOTONIC, &ts);
+    return (double)ts.tv_sec*1000.0 + (double)ts.tv_nsec/1000000.0;
+}
+
 // Swap back buffer with front buffer (screen drawing)
 void SwapScreenBuffer(void)
 {
+    static unsigned int swapCount = 0;
+    double t0 = SwapClockMs();
     eglSwapBuffers(platform.device, platform.surface);
+    double t1 = SwapClockMs();
 
     if (!platform.gbmSurface || (-1 == platform.fd) || !platform.connector || !platform.crtc) TRACELOG(LOG_ERROR, "DISPLAY: DRM initialization failed to swap");
 
     struct gbm_bo *bo = gbm_surface_lock_front_buffer(platform.gbmSurface);
+    double t2 = SwapClockMs();
     if (!bo) TRACELOG(LOG_ERROR, "DISPLAY: Failed GBM to lock front buffer");
 
     uint32_t fb = 0;
@@ -574,5 +589,6 @@ void SwapScreenBuffer(void)
     int result = drmModeAddFB(platform.fd, platform.connector->modes[platform.modeIndex].hdisplay, platform.connector->modes[platform.modeIndex].vdisplay, highColor? 24 : 16, highColor? 32 : 16, gbm_bo_get_stride(bo), gbm_bo_get_handle(bo).u32, &fb);
     if (result != 0) TRACELOG(LOG_ERROR, "DISPLAY: drmModeAddFB() failed with result: %d", result);
+    double t3 = SwapClockMs();
 
     if (!platform.prevFB)
     {
@@ -600,6 +616,7 @@ void SwapScreenBuffer(void)
             if (result != 0) TRACELOG(LOG_ERROR, "DISPLAY: fallback drmModeSetCrtc() failed with result: %d", result);
         }
     }
+    double t4 = SwapClockMs();
 
     if (platform.prevFB)
     {
@@ -611,6 +628,14 @@ void SwapScreenBuffer(void)
     if (platform.prevBO) gbm_surface_release_buffer(platform.gbmSurface, platform.prevBO);
 
     platform.prevBO = bo;
+    double t5 = SwapClockMs();
+
+    swapCount++;
+    if ((swapCount % 120) == 0)
+    {
+        TRACELOG(LOG_INFO, "DRM_TIMING egl=%.2f lock=%.2f addfb=%.2f flip=%.2f cleanup=%.2f total=%.2f",
+            t1 - t0, t2 - t1, t3 - t2, t4 - t3, t5 - t4, t5 - t0);
+    }
 }
 
