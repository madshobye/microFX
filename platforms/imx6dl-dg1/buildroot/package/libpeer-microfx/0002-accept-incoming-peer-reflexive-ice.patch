 #define AGENT_CONNCHECK_PERIOD 100
 #define AGENT_STUN_RECV_MAXTIMES 1000
 
+static int agent_addr_endpoint_equal(const Address* a, const Address* b) {
+  if (a->family != b->family || a->port != b->port) {
+    return 0;
+  }
+  if (a->family == AF_INET) {
+    return a->sin.sin_addr.s_addr == b->sin.sin_addr.s_addr;
+  }
+#if CONFIG_IPV6
+  if (a->family == AF_INET6) {
+    return memcmp(&a->sin6.sin6_addr, &b->sin6.sin6_addr,
+                  sizeof(a->sin6.sin6_addr)) == 0;
+  }
+#endif
+  return 0;
+}
+
+/*
+ * A browser may hide its LAN address behind an mDNS ICE candidate.  The
+ * usable endpoint is then learned from the authenticated Binding Request
+ * itself (a peer-reflexive candidate).  Upstream libpeer responded to that
+ * request but never selected its source endpoint, so ICE timed out even on
+ * the same LAN.
+ */
+static void agent_select_incoming_pair(Agent* agent, Address* addr) {
+  IceCandidate* remote = NULL;
+  IceCandidatePair* pair;
+  int i;
+
+  for (i = 0; i < agent->remote_candidates_count; i++) {
+    if (agent_addr_endpoint_equal(&agent->remote_candidates[i].addr, addr)) {
+      remote = &agent->remote_candidates[i];
+      break;
+    }
+  }
+
+  if (remote == NULL) {
+    if (agent->remote_candidates_count >= AGENT_MAX_CANDIDATES) {
+      LOGW("Cannot add peer-reflexive ICE candidate: list full");
+      return;
+    }
+    remote = &agent->remote_candidates[agent->remote_candidates_count];
+    ice_candidate_create(remote, agent->remote_candidates_count,
+                         ICE_CANDIDATE_TYPE_PRFLX, addr);
+    agent->remote_candidates_count++;
+  }
+
+  for (i = 0; i < agent->candidate_pairs_num; i++) {
+    if (agent->candidate_pairs[i].remote == remote) {
+      pair = &agent->candidate_pairs[i];
+      pair->state = ICE_CANDIDATE_STATE_SUCCEEDED;
+      agent->nominated_pair = pair;
+      agent->selected_pair = pair;
+      LOGI("Selected incoming peer-reflexive ICE pair");
+      return;
+    }
+  }
+
+  if (agent->local_candidates_count == 0 ||
+      agent->candidate_pairs_num >= AGENT_MAX_CANDIDATE_PAIRS) {
+    LOGW("Cannot create incoming peer-reflexive ICE pair");
+    return;
+  }
+  pair = &agent->candidate_pairs[agent->candidate_pairs_num++];
+  pair->local = &agent->local_candidates[0];
+  pair->remote = remote;
+  pair->priority = pair->local->priority + pair->remote->priority;
+  pair->conncheck = 0;
+  pair->state = ICE_CANDIDATE_STATE_SUCCEEDED;
+  agent->nominated_pair = pair;
+  agent->selected_pair = pair;
+  LOGI("Selected new incoming peer-reflexive ICE pair");
+}
+
