diff --git a/src/peer_connection.c b/src/peer_connection.c
index c763e80..f5f0a51 100644
--- a/src/peer_connection.c
+++ b/src/peer_connection.c
@@ -576,12 +576,50 @@ char* peer_connection_lookup_sid_label(PeerConnection* pc, uint16_t sid) {
   return NULL;  // Not found
 }
 
+static void peer_connection_add_pairs_for_remote(PeerConnection* pc, IceCandidate* remote) {
+  Agent* agent = &pc->agent;
+  int i;
+  int j;
+  for (i = 0; i < agent->local_candidates_count; i++) {
+    if (agent->local_candidates[i].addr.family != remote->addr.family) continue;
+    for (j = 0; j < agent->candidate_pairs_num; j++) {
+      if (agent->candidate_pairs[j].local == &agent->local_candidates[i] &&
+          agent->candidate_pairs[j].remote == remote) {
+        break;
+      }
+    }
+    if (j != agent->candidate_pairs_num) continue;
+    if (agent->candidate_pairs_num >= AGENT_MAX_CANDIDATE_PAIRS) {
+      LOGW("Cannot add trickle ICE pair: list full");
+      return;
+    }
+    IceCandidatePair* pair = &agent->candidate_pairs[agent->candidate_pairs_num++];
+    pair->local = &agent->local_candidates[i];
+    pair->remote = remote;
+    pair->priority = pair->local->priority + pair->remote->priority;
+    pair->conncheck = 0;
+    pair->state = ICE_CANDIDATE_STATE_FROZEN;
+  }
+}
+
 int peer_connection_add_ice_candidate(PeerConnection* pc, char* candidate) {
   Agent* agent = &pc->agent;
-  if (ice_candidate_from_description(&agent->remote_candidates[agent->remote_candidates_count], candidate, candidate + strlen(candidate)) != 0) {
+  if (agent->remote_candidates_count >= AGENT_MAX_CANDIDATES) return -1;
+  IceCandidate* remote = &agent->remote_candidates[agent->remote_candidates_count];
+  if (ice_candidate_from_description(remote, candidate, candidate + strlen(candidate)) != 0) {
     return -1;
   }
   LOGD("Add candidate: %s", candidate);
   agent->remote_candidates_count++;
+  peer_connection_add_pairs_for_remote(pc, remote);
+
+  /* Chrome normally trickles candidates after the answer is sent.  The
+   * original implementation entered FAILED immediately with an empty pair
+   * list and never reconsidered late candidates. */
+  if (pc->state == PEER_CONNECTION_FAILED || pc->state == PEER_CONNECTION_NEW) {
+    agent->nominated_pair = NULL;
+    agent->selected_pair = NULL;
+    STATE_CHANGED(pc, PEER_CONNECTION_CHECKING);
+  }
   return 0;
 }
